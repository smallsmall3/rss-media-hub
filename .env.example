# ============================================================================
#  复制成 .env 后填写：  cp .env.example .env
#  .env 不要提交到 git（已在 .gitignore 里）
# ============================================================================

TZ=Asia/Shanghai

# ---------- Telegram（必填） ----------
# 找 @BotFather 建机器人拿 Token
RMH_TG_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 推送目标：私聊填你的 user id；群/频道填 -100xxxxxxxxxx
RMH_TG_CHAT_ID=123456789
# 可选：群里的话题(Thread) ID，没有就留空（私聊必须留空）
RMH_TG_THREAD_ID=
# 可选：【正向代理】科学上网端口，TG 直连不通时填，例如 http://192.168.31.142:10809
# 支持 http:// 与 socks5:// ；留空=直连
RMH_TG_PROXY=
# 可选：【反向代理】只有你自己用域名反代了 TG 才填，例如 https://tgapi.example.com
# 注意：这里不是代理端口，而是能直接替换 api.telegram.org 的地址
RMH_TG_API_BASE=
# 可选：推送里的链接指向哪里（默认 detail，安全）
#   detail   = 详情页，不含 passkey，转发或截图都安全
#   download = PT 直链，点一下就开始下载，但链接里有你的 passkey
# 即使选了 download，只要链接里带 passkey 且能推出详情页，也会自动退回详情页。
RMH_TG_LINK_MODE=detail

# ---------- TMDB（必填） ----------
# https://www.themoviedb.org/settings/api  用 v3 auth 的那串 32 位 api_key
RMH_TMDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 国内直连 TMDB 通常不通，二选一：
#   正向代理（通常和 TG 那个填同一个）
RMH_TMDB_PROXY=
#   或自建反向代理
RMH_TMDB_API_BASE=
# zh-CN 取中文标题；想要原始标题填 en-US
RMH_TMDB_LANGUAGE=zh-CN

# ---------- Emby / Jellyfin（必填，用于统计"已入库集数"） ----------
# 两种填法：
#   1) Emby：填完整地址 + API 密钥（Emby 后台 → 高级 → API 密钥 → 新建）
#   2) Jellyfin：填完整地址 + API 密钥
RMH_EMBY_URL=http://192.168.1.10:8096
RMH_EMBY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 兼容旧版 Emby（<4.7）需要填 userId；新版留空即可
RMH_EMBY_USER_ID=
# 统计口径：只算已播出集数(true) 还是 TMDB 全部集数(false)
RMH_EMBY_COUNT_AIRED_ONLY=true

# ---------- 可选：跑起来先不推送旧条目 ----------
# RSS 第一轮只做"登记"不推送（防止一上线就被历史条目刷屏），默认 true
RMH_SEED_SILENT=true
# 轮询与巡检间隔（秒）
# RSS 刷新间隔：你想"每 2-5 分钟看一次新数据"就填 120~300
RMH_POLL_INTERVAL=180
# show（按剧追踪）模式的入库巡检间隔，feed 模式用不到
RMH_RECONCILE_INTERVAL=1800
# 日志级别：DEBUG / INFO / WARNING
RMH_LOG_LEVEL=INFO

# ---------- 网页 UI ----------
# 访问 http://<NAS IP>:18080/ 即可用界面配置一切（改完热重载，不用重启容器）
# ⚠️ 强烈建议设置访问口令：不设的话同一局域网内任何人都能打开并改你的配置
RMH_UI_TOKEN=
# 想彻底关掉网页 UI（只保留 /healthz）就设成 false
RMH_UI_ENABLED=true

# ---------- 全库扫描（python -m app scan / 网页上的「媒体库」标签）----------
# TMDB 结果缓存多久（秒），默认 12 小时；重复扫描时几乎不打 TMDB
RMH_SCAN_CACHE_TTL=43200
# 扫描并发数，调大更容易被 TMDB 限流
RMH_SCAN_CONCURRENCY=5
# 单次最多扫描多少部剧，0=不限；库很大时建议先设 50 试水
RMH_SCAN_MAX_SERIES=0
